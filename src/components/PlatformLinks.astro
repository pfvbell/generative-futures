---
/**
 * The platform bar — the site's whole reason for existing: send people to the
 * Substack, YouTube, and podcast. Inline SVG icons (no external requests).
 */
import { PLATFORM_LIST } from '../site.config';

interface Props {
  /** Only show the primary platforms (Substack/YouTube/Spotify). */
  primaryOnly?: boolean;
  showHandles?: boolean;
}
const { primaryOnly = false, showHandles = true } = Astro.props;
const items = primaryOnly
  ? PLATFORM_LIST.filter((p) => p.primary)
  : PLATFORM_LIST;

const icons: Record<string, string> = {
  Substack:
    '<path d="M3 3h18v3H3zM3 8.5h18V22l-9-5-9 5zM3 8.5h18" fill="currentColor"/>',
  YouTube:
    '<path d="M21.6 7.2a2.7 2.7 0 0 0-1.9-1.9C18 5 12 5 12 5s-6 0-7.7.3A2.7 2.7 0 0 0 2.4 7.2 28 28 0 0 0 2 12a28 28 0 0 0 .4 4.8 2.7 2.7 0 0 0 1.9 1.9C6 19 12 19 12 19s6 0 7.7-.3a2.7 2.7 0 0 0 1.9-1.9A28 28 0 0 0 22 12a28 28 0 0 0-.4-4.8zM10 15V9l5 3z" fill="currentColor"/>',
  Spotify:
    '<path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.6 14.4a.62.62 0 0 1-.86.21c-2.35-1.44-5.3-1.76-8.79-.96a.62.62 0 1 1-.28-1.22c3.8-.87 7.08-.5 9.72 1.11a.62.62 0 0 1 .21.86zm1.23-2.74a.78.78 0 0 1-1.07.26c-2.69-1.65-6.79-2.13-9.97-1.17a.78.78 0 1 1-.45-1.5c3.63-1.09 8.15-.56 11.24 1.34a.78.78 0 0 1 .25 1.07zm.1-2.85C14.83 8.96 9.4 8.78 6.3 9.72a.94.94 0 1 1-.54-1.8c3.56-1.08 9.56-.87 13.33 1.37a.94.94 0 0 1-.96 1.61z" fill="currentColor"/>',
  'Apple Podcasts':
    '<path d="M12 2a10 10 0 0 0-3 19.5c-.1-.8-.04-1.6.16-2.4l.84-3.2a3 3 0 1 1 4 0l.84 3.2c.2.8.26 1.6.16 2.4A10 10 0 0 0 12 2zm0 5a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm-1.6 11.8a2.2 2.2 0 0 1 3.2 0c.3.4.4.9.3 1.4l-.5 1.9c-.2.6-.7 1-1.4 1s-1.2-.4-1.4-1l-.5-1.9c-.1-.5 0-1 .3-1.4z" fill="currentColor"/>',
  'Podcast RSS':
    '<path d="M5 3a2 2 0 0 0-2 2 2 2 0 0 0 0 0c8.28 0 15 6.72 15 15a2 2 0 0 0 4 0C22 11.07 13.93 3 4 3zm-.5 7a2 2 0 0 0 0 4 6 6 0 0 1 6 6 2 2 0 0 0 4 0 10 10 0 0 0-10-10zM6 16a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z" fill="currentColor"/>',
};
---

<div class="platforms">
  {
    items.map((p) => (
      <a class="platform" href={p.url} rel="noopener" target="_blank">
        <svg class="platform__icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[p.label] ?? ''} />
        <span>
          {p.label}
          {showHandles && <small>{p.handle}</small>}
        </span>
      </a>
    ))
  }
</div>
