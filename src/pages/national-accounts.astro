---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlatformLinks from '../components/PlatformLinks.astro';
import FAQ from '../components/FAQ.astro';
import LineChart from '../components/accounts/LineChart.astro';
import BarChart from '../components/accounts/BarChart.astro';
import HBars from '../components/accounts/HBars.astro';
import series from '../data/national-accounts/series.json';
import ref from '../data/national-accounts/reference.json';
import { breadcrumbSchema, faqSchema, PERSON_ID, ORG_ID, WEBSITE_ID } from '../lib/schema';
import { SITE } from '../site.config';
import { r1, fmt } from '../lib/charts';

/* ------------------------------------------------------------------ *
 * The New National Accounts: the measurements proposed in the working
 * essay "A Political Economy for the Age of AI", kept for the UK from
 * official statistics. Every figure below is computed here at build
 * time from src/data/national-accounts/ (series.json is refreshed with
 * `npm run accounts:refresh`; reference.json is updated by hand).
 * ------------------------------------------------------------------ */

const RED = 'var(--na-red)';
const BLUE = 'var(--na-blue)';
const GREY = 'var(--na-grey)';
const pct = (v: number, d = 1) => fmt(v, d, '%');
const usd = (v: number) => `$${Math.round(v).toLocaleString('en-US')}`;
const gbp = (v: number) => `£${Math.round(v).toLocaleString('en-GB')}`;
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const monthIdx = (m: string) => MON.findIndex((s) => s.toLowerCase() === m.toLowerCase());
/** "2026 JUN-AUG" → "Jun–Aug 2026"; periods that cross a year keep both years. */
const period = (p: string) => {
  const m = /^(\d{4}) (\w{3})-(\w{3})$/i.exec(p);
  if (!m) return p;
  const [a, b, yr] = [monthIdx(m[2]), monthIdx(m[3]), Number(m[1])];
  return b < a ? `${MON[a]} ${yr} to ${MON[b]} ${yr + 1}` : `${MON[a]}–${MON[b]} ${yr}`;
};
const monthX = (m: string) => {
  const [yy, mm] = m.split('-').map(Number);
  return yy + (mm - 0.5) / 12;
};
const longDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/London' });
const ageLabel = (a: string) => a.replace(/^(\d+) to (\d+)$/, '$1–$2').replace(/^(\d+) and above$/, '$1+');
const yearTicks = (from: number, to: number, step: number) =>
  Array.from({ length: Math.floor((to - from) / step) + 1 }, (_, i) => ({ x: from + i * step, label: String(from + i * step) }));
const maxBy = <T,>(rows: T[], f: (r: T) => number) => rows.reduce((a, b) => (f(b) > f(a) ? b : a));
const minBy = <T,>(rows: T[], f: (r: T) => number) => rows.reduce((a, b) => (f(b) < f(a) ? b : a));

// Proposition 1: the wage share
const wage = series.wage_share.map((r) => ({ year: r.year, pct: r1((100 * r.compensation_gbp_m) / r.gdp_gbp_m) }));
const wLast = wage[wage.length - 1];
const wPeak = maxBy(wage, (r) => r.pct);
const wLow = minBy(wage, (r) => r.pct);

// Proposition 2: rent
const hp = ref.house_price_earnings;
const hpPeak = maxBy(hp, (r) => r.ratio_england);
const rent = ref.register.find((r) => r.key === 'rent_share')!;

// Proposition 3: a stake
const pfd = series.alaska_pfd;
const pfdTotal = Math.round(pfd.reduce((s, r) => s + r.dividend_usd, 0));
const pfdMax = maxBy(pfd, (r) => r.dividend_usd);
const funds = [series.norway_fund, ...ref.funds]
  .map((f) => ({ ...f, pct_gdp: r1((100 * f.assets_bn) / f.gdp_bn) }))
  .sort((a, b) => b.pct_gdp - a.pct_gdp);
const norway = funds.find((f) => f.place === 'Norway')!;
const ukFund = funds.find((f) => f.place === 'United Kingdom')!;
const deciles = ref.wealth_deciles.rows;
const wealthTotal = deciles.reduce((s, r) => s + r.aggregate_wealth_gbp_m, 0);
const wealthOf = (lo: number, hi: number) =>
  deciles.filter((r) => r.decile >= lo && r.decile <= hi).reduce((s, r) => s + r.aggregate_wealth_gbp_m, 0);
const split = [
  { group: 'Top 10%', share: r1((100 * wealthOf(10, 10)) / wealthTotal), color: RED },
  { group: 'Middle 40%', share: r1((100 * wealthOf(6, 9)) / wealthTotal), color: GREY },
  { group: 'Bottom 50%', share: r1((100 * wealthOf(1, 5)) / wealthTotal), color: BLUE },
];
const topToBottom = r1(wealthOf(10, 10) / wealthOf(1, 5));
const ages = ref.wealth_by_age.rows;
const ageMax = maxBy(ages, (r) => r.median_wealth_gbp);

// Proposition 6: selling assets
const own = ref.share_ownership;
const oFirst = own[0];
const oLast = own[own.length - 1];
const ca = series.current_account;
const caLast = ca[ca.length - 1];
const caSurplus = ca.filter((r) => r.balance_pct_gdp > 0).at(-1)!;

// Proposition 7: mediation
const ud = ref.union_density;
const udFirst = ud[0];
const udLast = ud[ud.length - 1];
const udChange = r1(udLast.density_pct - udFirst.density_pct);
const coverage = [...ref.bargaining_coverage].sort((a, b) => b.coverage_pct - a.coverage_pct);
const ukCoverage = coverage.find((r) => r.iso3 === 'GBR')!;

// Crisis watch: entry-level labour market
const un = series.unemployment;
const uLast = un[un.length - 1];
const uAgo = un[un.length - 13];
const uChange = r1(uLast.youth_pct - uAgo.youth_pct);
const uPeak = maxBy(un.slice(-12), (r) => r.youth_pct);
const uPrior = un.slice(0, -12).filter((r) => r.youth_pct >= uPeak.youth_pct).at(-1);

// Measurement
const reg = ref.register;
const regCount = (s: string) => reg.filter((r) => r.status === s).length;
const releases = [...series.releases, ...ref.releases];
const refreshed = longDate(series.generated);

const faqs = [
  {
    question: 'What are the new national accounts?',
    answer: `A proposed set of statistics for an AI economy, from the working essay A Political Economy for the Age of AI: the rent share of national income, asset ownership by age and region, task-level labour data, a security index, compute and data as national capital, time use, and mediation density. Of these ${reg.length} accounts, official UK statistics cover ${regCount('Partial')} in part and ${regCount('Not counted')} not at all.`,
  },
  {
    question: 'What share of UK national income goes to workers?',
    answer: `Compensation of employees was ${pct(wLast.pct)} of UK GDP in ${wLast.year}, according to ONS national accounts. It peaked at ${pct(wPeak.pct)} in ${wPeak.year} and fell to a low of ${pct(wLow.pct)} in ${wLow.year}.`,
  },
  {
    question: 'Does the UK have a sovereign wealth fund that pays a dividend?',
    answer: `No. The UK's National Wealth Fund is a public investment bank with £${ukFund.assets_bn}bn of capital, about ${pct(ukFund.pct_gdp)} of GDP, and pays no dividend. Norway's fund is worth about ${pct(norway.pct_gdp, 0)} of Norway's GDP, and Alaska has paid every eligible resident a dividend each year since ${pfd[0].year}, ${usd(pfdTotal)} in total.`,
  },
  {
    question: 'How high is youth unemployment in the UK?',
    answer: `${pct(uLast.youth_pct)} of economically active 16 to 24 year olds were unemployed in ${period(uLast.period)}, according to the ONS Labour Force Survey, ${fmt(uChange, 1, ' points', true)} on a year earlier. The rate reached ${pct(uPeak.youth_pct)} in ${period(uPeak.period)}${uPrior ? `, its highest since ${period(uPrior.period)}` : ''}.`,
  },
];

const pageTitle = 'The New National Accounts';
const pageDesc =
  'The national accounts Britain would need for the age of AI, kept from official statistics: the wage share, rent, wealth funds, asset ownership, unions and youth unemployment, plus the accounts nobody publishes yet.';
const path = '/national-accounts';
const url = `${SITE.url}${path}`;
const published = '2026-10-23T09:00:00.000Z';
const keywords = [
  'national accounts', 'political economy of AI', 'labour share', 'wage share UK', 'rent share',
  'sovereign wealth fund', 'citizens wealth fund', 'Alaska Permanent Fund dividend', 'trade union density',
  'youth unemployment UK', 'Keynes',
];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: pageTitle,
    name: pageTitle,
    description: pageDesc,
    url,
    inLanguage: SITE.language,
    datePublished: published,
    dateModified: series.generated,
    keywords: keywords.join(', '),
    about: ['National accounts', 'Political economy of AI', 'Wealth funds', 'Labour share', 'Collective bargaining']
      .map((name) => ({ '@type': 'Thing', name })),
    author: { '@id': PERSON_ID },
    publisher: { '@id': ORG_ID },
    isPartOf: { '@id': WEBSITE_ID },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  },
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: pageTitle, path },
  ]),
  faqSchema(faqs),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  path={path}
  ogType="article"
  publishedTime={published}
  modifiedTime={series.generated}
  keywords={keywords}
  schema={schema}
>
  <div class="gna">
    <header class="na-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a> › <span>{pageTitle}</span>
        </nav>
        <p class="na-kicker">Prototype accounts for the United Kingdom</p>
        <h1>{pageTitle}</h1>
        <p class="na-lede">
          Keynes needed national income accounting before he could manage demand. The working essay
          <em>A Political Economy for the Age of AI</em> argues that Britain now needs a new set of accounts:
          who owns the returns, who carries the risk, and who still bargains. This page keeps the ones official
          statistics can already fill, and lists the ones nobody publishes yet.
        </p>
        <p class="na-take">
          Workers take <b>{pct(wLast.pct)}</b> of national income. Overseas investors own <b>{pct(oLast.rest_of_world_pct)}</b>
          of UK quoted shares, and <b>{pct(uLast.youth_pct)}</b> of young people in the labour market are out of work.
          Of the {reg.length} accounts the essay calls for, <b>{regCount('Not counted')}</b> are not kept at all.
        </p>
        <ul class="na-meta">
          <li>Latest data: {period(uLast.period)}</li>
          <li>Refreshed {refreshed}</li>
          <li>Official statistics from the ONS, DBT, OECD and others</li>
        </ul>
      </div>
    </header>

    <div class="container">
      <section class="na-strip" aria-label="Headline figures">
        <div class="na-fig">
          <p class="na-fig-l">Workers' share of national income, {wLast.year}</p>
          <p class="na-fig-v">{pct(wLast.pct)}</p>
          <p class="na-fig-n">Peak {pct(wPeak.pct)} in {wPeak.year}</p>
          <p class="na-fig-t">Proposition 1</p>
        </div>
        <div class="na-fig">
          <p class="na-fig-l">Unemployment, ages 16 to 24, {period(uLast.period)}</p>
          <p class="na-fig-v">{pct(uLast.youth_pct)}</p>
          <p class="na-fig-n">{fmt(uChange, 1, ' pts', true)} on a year earlier</p>
          <p class="na-fig-t">Crisis watch</p>
        </div>
        <div class="na-fig">
          <p class="na-fig-l">UK quoted shares owned overseas, {oLast.year}</p>
          <p class="na-fig-v">{pct(oLast.rest_of_world_pct)}</p>
          <p class="na-fig-n">{pct(oFirst.rest_of_world_pct)} in {oFirst.year}</p>
          <p class="na-fig-t">Proposition 6</p>
        </div>
        <div class="na-fig">
          <p class="na-fig-l">Current account balance, share of GDP, {caLast.year}</p>
          <p class="na-fig-v">{fmt(caLast.balance_pct_gdp, 1, '%')}</p>
          <p class="na-fig-n">Last annual surplus in {caSurplus.year}</p>
          <p class="na-fig-t">Proposition 6</p>
        </div>
        <div class="na-fig">
          <p class="na-fig-l">Employees in a trade union, {udLast.year}</p>
          <p class="na-fig-v">{pct(udLast.density_pct)}</p>
          <p class="na-fig-n">{fmt(udChange, 1, ' pts', true)} since {udFirst.year}</p>
          <p class="na-fig-t">Proposition 7</p>
        </div>
      </section>
    </div>

    <section class="na-band" id="distribution">
      <div class="container na-sec">
        <header class="na-head">
          <p class="na-num">Proposition 1</p>
          <h2>Distribution determines demand</h2>
          <blockquote class="na-quote">“Distribution is a macro variable. The equity-efficiency trade-off runs the other way at current levels of inequality.”</blockquote>
        </header>
        <div class="na-grid">
          <figure class="na-ex na-wide" id="wage-share">
            <figcaption>
              <h3>Workers' share of national income</h3>
              <p class="na-note">
                Wages, salaries and employer contributions as a share of GDP. It peaked at {pct(wPeak.pct)} in {wPeak.year}
                and bottomed at {pct(wLow.pct)} in {wLow.year}. The 2020 jump reflects furlough pay while output fell.
              </p>
            </figcaption>
            <LineChart
              id="wage"
              label={`Line chart: wage share of UK GDP, ${wage[0].year} to ${wLast.year}`}
              x={wage.map((r) => r.year)}
              series={[{ label: 'Wage share', values: wage.map((r) => r.pct), color: RED, area: true }]}
              xTicks={yearTicks(1950, 2020, 10)}
              tipTitles={wage.map((r) => String(r.year))}
              yMin={40}
              unit="%"
              height={300}
              events={[{ x: 1979, label: 'Thatcher elected' }, { x: 2008, label: 'Financial crisis' }]}
            />
            <p class="na-src">
              Source: ONS UK Economic Accounts, series
              <a href="https://www.ons.gov.uk/economy/grossdomesticproductgdp/timeseries/dtwm/ukea">DTWM</a> divided by
              <a href="https://www.ons.gov.uk/economy/grossdomesticproductgdp/timeseries/ybha/ukea">YBHA</a>, current prices.
            </p>
          </figure>
        </div>
      </div>
    </section>

    <section class="na-band" id="rent">
      <div class="container na-sec">
        <header class="na-head">
          <p class="na-num">Proposition 2</p>
          <h2>Rent, not profit</h2>
          <blockquote class="na-quote">“Rent share of national income is the variable to track and reduce. Tax rents, not production.”</blockquote>
        </header>
        <div class="na-grid">
          <figure class="na-ex" id="house-prices">
            <figcaption>
              <h3>House prices against earnings</h3>
              <p class="na-note">
                Median house price as a multiple of median full-time earnings where people work. England peaked at
                {fmt(hpPeak.ratio_england, 1)} times in {hpPeak.year}, partly because measured earnings dipped that year.
              </p>
            </figcaption>
            <LineChart
              id="house"
              label="Line chart: house price to earnings ratio, England and London"
              x={hp.map((r) => r.year)}
              series={[
                { label: 'England', values: hp.map((r) => r.ratio_england), color: RED, area: true },
                { label: 'London', values: hp.map((r) => r.ratio_london), color: BLUE },
              ]}
              xTicks={yearTicks(2000, 2025, 5)}
              tipTitles={hp.map((r) => String(r.year))}
              yMin={0}
              decimals={1}
              height={280}
            />
            <p class="na-src">
              Source: ONS, <a href="https://www.ons.gov.uk/peoplepopulationandcommunity/housing/bulletins/housingaffordabilityinenglandandwales/2025">Housing affordability in England and Wales: 2025</a>, table 1c.
            </p>
          </figure>
          <figure class="na-ex" id="rent-share">
            <figcaption>
              <h3>The rent share of national income</h3>
            </figcaption>
            <p class="na-verdict">{rent.status}</p>
            <p class="na-body">
              This is the account the essay builds everything else on: the share of income that goes to whoever owns land,
              housing, data, compute, platforms and patents, rather than to whoever builds things.
            </p>
            <p class="na-note">{rent.nearest_official}</p>
          </figure>
        </div>
      </div>
    </section>

    <section class="na-band" id="stake">
      <div class="container na-sec">
        <header class="na-head">
          <p class="na-num">Proposition 3</p>
          <h2>Everyone needs a stake</h2>
          <blockquote class="na-quote">“Everyone needs a claim on capital income that does not depend on their wage or their credential.”</blockquote>
        </header>
        <div class="na-grid">
          <figure class="na-ex na-wide" id="alaska">
            <figcaption>
              <h3>Alaska's dividend, paid every year since {pfd[0].year}</h3>
            </figcaption>
            <p class="na-total"><b>{usd(pfdTotal)}</b><span>paid in total to a resident who qualified in all {pfd.length} years</span></p>
            <p class="na-note">
              Amount paid to each eligible resident, in US dollars, not adjusted for inflation. Some years include one-off
              energy relief. Alaska's fund is capitalised from oil revenue; the essay's version would be capitalised from captured rents.
            </p>
            <BarChart
              label={`Column chart: Alaska Permanent Fund Dividend per resident, ${pfd[0].year} to ${pfd[pfd.length - 1].year}`}
              bars={pfd.map((r) => ({
                value: r.dividend_usd,
                color: RED,
                title: `${r.year} dividend`,
                display: usd(r.dividend_usd),
                tick: r.year % 5 === 0 ? String(r.year) : undefined,
                minor: r.year % 10 !== 0,
                label: r === pfdMax ? usd(r.dividend_usd) : undefined,
              }))}
              tipLabel="Per resident"
              tickFmt={(v) => usd(v)}
              height={240}
            />
            <p class="na-src">
              Source: Alaska Department of Revenue, <a href="https://pfd.alaska.gov/Division-Info/summary-of-dividend-applications-payments">Summary of dividend applications and payments</a>.
            </p>
          </figure>

          <figure class="na-ex" id="wealth-funds">
            <figcaption>
              <h3>Public wealth funds against the economy</h3>
              <p class="na-note">
                Fund assets as a share of each economy's GDP. Britain's National Wealth Fund is a public investment bank:
                it pays no dividend and no citizen owns a share.
              </p>
            </figcaption>
            <HBars
              stacked
              label="Bar chart: wealth fund assets as a share of GDP for Norway, Alaska and the United Kingdom"
              rows={funds.map((f) => ({
                label: f.place,
                sub: `${f.fund}, ${f.pays_dividend.startsWith('Yes') ? 'pays a dividend' : 'no dividend'}`,
                value: f.pct_gdp,
                display: `${f.pct_gdp.toLocaleString('en-GB')}% of GDP`,
                color: f.place === 'United Kingdom' ? RED : GREY,
                me: f.place === 'United Kingdom',
              }))}
            />
            <p class="na-src">
              Sources: <a href="https://www.nbim.no/en/the-fund/market-value/">NBIM</a> and
              <a href="https://www.ssb.no/en/statbank/table/09189">Statistics Norway</a>;
              <a href="https://apfc.org/fund-news/fy26-audit-and-budget-proposal/">APFC</a> and BEA state GDP
              (<a href="https://en.wikipedia.org/wiki/List_of_U.S._states_and_territories_by_GDP">as compiled here</a>);
              <a href="https://www.gov.uk/government/publications/national-wealth-fund-mobilising-private-investment">HM Treasury</a> and ONS.
            </p>
          </figure>

          <figure class="na-ex" id="wealth-split">
            <figcaption>
              <h3>Who holds Britain's household wealth</h3>
              <p class="na-note">
                Share of all household wealth, including pensions, Great Britain, {ref.wealth_deciles.period}.
                The top tenth holds {fmt(topToBottom, 1)} times as much as the bottom half.
              </p>
            </figcaption>
            <div class="na-split" role="img" aria-label={split.map((s) => `${s.group} ${pct(s.share)}`).join(', ')}>
              {split.map((s) => <i style={`flex:${s.share} 1 0;background:${s.color}`}></i>)}
            </div>
            <div class="na-split-key">
              {split.map((s) => (
                <div>
                  <p class="na-split-v">{pct(s.share)}</p>
                  <p class="na-split-l"><i class="na-sw" style={`background:${s.color}`}></i>{s.group}</p>
                </div>
              ))}
            </div>
            <p class="na-src">
              Source: ONS, <a href="https://www.ons.gov.uk/peoplepopulationandcommunity/personalandhouseholdfinances/incomeandwealth/bulletins/totalwealthingreatbritain/april2020tomarch2022">Household total wealth in Great Britain</a>, table 2.2 decile totals.
            </p>
          </figure>

          <figure class="na-ex na-wide" id="wealth-age">
            <figcaption>
              <h3>Wealth by age</h3>
              <p class="na-note">
                Median total household wealth, including pensions, by age of the head of household, Great Britain,
                {ref.wealth_by_age.period}. The essay's coalition is generational: under-forties own almost nothing.
              </p>
            </figcaption>
            <BarChart
              label="Column chart: median household wealth by age band"
              bars={ages.map((r, i) => ({
                value: r.median_wealth_gbp,
                color: RED,
                title: `Aged ${ageLabel(r.age_band)}`,
                display: gbp(r.median_wealth_gbp),
                tick: ageLabel(r.age_band),
                label: i === 0 || r === ageMax ? gbp(r.median_wealth_gbp) : undefined,
              }))}
              tipLabel="Median wealth"
              tickFmt={(v) => `£${(v / 1000).toLocaleString('en-GB')}k`}
              height={240}
            />
            <p class="na-src">
              Source: ONS, <a href="https://www.ons.gov.uk/peoplepopulationandcommunity/personalandhouseholdfinances/incomeandwealth/bulletins/totalwealthingreatbritain/april2020tomarch2022">Household total wealth in Great Britain</a>, figure 2.
            </p>
          </figure>
        </div>
      </div>
    </section>

    <section class="na-band" id="assets">
      <div class="container na-sec">
        <header class="na-head">
          <p class="na-num">Proposition 6</p>
          <h2>A middle power that sells its assets</h2>
          <blockquote class="na-quote">“It sells assets (property, gilts, companies, financial services) rather than goods. The kindness of strangers.”</blockquote>
        </header>
        <div class="na-grid">
          <figure class="na-ex" id="share-ownership">
            <figcaption>
              <h3>Who owns UK-listed companies</h3>
              <p class="na-note">Share of the value of UK quoted shares, by beneficial owner. Surveys are irregular, and the ONS advises care comparing years before 2010.</p>
            </figcaption>
            <LineChart
              id="shares"
              label="Line chart: ownership of UK quoted shares by overseas investors and UK individuals"
              x={own.map((r) => r.year)}
              series={[
                { label: 'Overseas', values: own.map((r) => r.rest_of_world_pct), color: RED },
                { label: 'UK individuals', values: own.map((r) => r.individuals_pct), color: BLUE },
              ]}
              xTicks={yearTicks(1970, 2020, 10)}
              tipTitles={own.map((r) => String(r.year))}
              yMin={0}
              unit="%"
              points
              height={280}
            />
            <p class="na-src">
              Source: ONS, <a href="https://www.ons.gov.uk/economy/investmentspensionsandtrusts/bulletins/ownershipofukquotedshares/2024">Ownership of UK quoted shares: 2024</a>, table 12.
            </p>
          </figure>
          <figure class="na-ex" id="current-account">
            <figcaption>
              <h3>Current account balance</h3>
              <p class="na-note">Per cent of GDP. A deficit is financed by selling assets or borrowing from abroad. The last annual surplus was in {caSurplus.year}.</p>
            </figcaption>
            <BarChart
