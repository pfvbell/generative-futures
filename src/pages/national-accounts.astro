<script>
  type Row = { l: string; v: string; c?: string };
  const make = (tag: string, cls: string, text?: string) => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  };
  const fill = (tip: HTMLElement, title: string, rows: Row[]) => {
    tip.replaceChildren(
      make('div', 'na-tip-h', title),
      ...rows.map((r) => {
        const row = make('div', 'na-tip-r');
        if (r.c) {
          const sw = make('i', 'na-tip-sw');
          sw.style.background = r.c;
          row.append(sw);
        }
        row.append(make('span', '', r.l), make('b', '', r.v));
        return row;
      }),
    );
    tip.hidden = false;
  };
  const place = (tip: HTMLElement, host: HTMLElement, x: number) => {
    const tw = tip.offsetWidth;
    let left = x + 14;
    if (left + tw > host.clientWidth) left = x - 14 - tw;
    tip.style.left = `${Math.max(0, left)}px`;
  };

  // Line charts: crosshair, a dot per series and a tooltip at the nearest point
  document.querySelectorAll<HTMLElement>('.lc-hit').forEach((hit) => {
    const d = JSON.parse(hit.dataset.tips || '{}') as {
      x: number[]; t: string[]; s: { l: string; c: string; y: (number | null)[]; v: string[] }[];
    };
    const cross = hit.querySelector<HTMLElement>('.lc-cross')!;
    const dots = [...hit.querySelectorAll<HTMLElement>('.lc-hdot')];
    const tip = hit.querySelector<HTMLElement>('.lc-tip')!;
    let cur = -1;
    const show = (i: number) => {
      cur = Math.max(0, Math.min(d.x.length - 1, i));
      const xp = d.x[cur];
      cross.style.left = `${xp}%`;
      cross.hidden = false;
      d.s.forEach((s, k) => {
        const yv = s.y[cur];
        dots[k].hidden = yv == null;
        if (yv != null) {
          dots[k].style.left = `${xp}%`;
          dots[k].style.bottom = `${yv}%`;
        }
      });
      fill(tip, d.t[cur], d.s.map((s) => ({ l: s.l, v: s.v[cur], c: d.s.length > 1 ? s.c : undefined })));
      place(tip, hit, (xp / 100) * hit.clientWidth);
    };
    const hide = () => {
      cross.hidden = true;
      dots.forEach((dot) => { dot.hidden = true; });
      tip.hidden = true;
    };
    const nearest = (p: number) => {
      let lo = 0;
      let hi = d.x.length - 1;
      while (hi - lo > 1) {
        const mid = (lo + hi) >> 1;
        if (d.x[mid] < p) lo = mid; else hi = mid;
      }
      return p - d.x[lo] < d.x[hi] - p ? lo : hi;
    };
    hit.addEventListener('pointermove', (e) => {
      const r = hit.getBoundingClientRect();
      show(nearest(((e.clientX - r.left) / r.width) * 100));
    });
    hit.addEventListener('pointerleave', hide);
    hit.addEventListener('focus', () => show(d.x.length - 1));
    hit.addEventListener('blur', hide);
    hit.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
        e.preventDefault();
        show(cur + (e.key === 'ArrowLeft' ? -1 : 1));
      }
      if (e.key === 'Escape') hide();
    });
  });

  // Column charts: highlight the hovered column and show its value
  document.querySelectorAll<HTMLElement>('.bc-plot').forEach((plot) => {
    const tip = plot.querySelector<HTMLElement>('.bc-tip')!;
    plot.querySelectorAll<HTMLElement>('.bc-col').forEach((col) => {
      col.addEventListener('pointerenter', () => {
        col.classList.add('bc-on');
        fill(tip, col.dataset.t || '', [{ l: col.dataset.l || '', v: col.dataset.v || '' }]);
        const pr = plot.getBoundingClientRect();
        const cr = col.getBoundingClientRect();
        place(tip, plot, cr.left - pr.left + cr.width / 2);
      });
      col.addEventListener('pointerleave', () => {
        col.classList.remove('bc-on');
        tip.hidden = true;
      });
    });
  });

  // Release calendar: mark releases whose date has passed since the last refresh
  const today = new Date().toISOString().slice(0, 10);
  document.querySelectorAll<HTMLElement>('tr[data-next]').forEach((tr) => {
    const next = tr.dataset.next;
    if (next && next < today) tr.classList.add('na-due');
  });
</script>

